    "check:business-readiness": "python3 scripts/business_readiness_check.py",
    "check:local-plates": "esbuild scripts/local-plate-check.ts --bundle --platform=node --format=cjs --outfile=.check/local-plate.cjs --log-level=error --loader:.png=empty --define:import.meta.env={} && node .check/local-plate.cjs",
    "check:local-plates-ui": "esbuild scripts/local-plate-ui-check.tsx --bundle --platform=node --format=cjs --outfile=.check/local-plate-ui.cjs --log-level=error --loader:.jpg=empty --loader:.png=empty --loader:.md=text --define:import.meta.env={} && node .check/local-plate-ui.cjs",
