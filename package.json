    "check:sosnovka": "esbuild scripts/sosnovka-check.ts --bundle --platform=node --format=cjs --outfile=.check/sosnovka.cjs --log-level=error && node .check/sosnovka.cjs",
    "check:map-search": "esbuild scripts/map-search-check.ts --bundle --platform=node --format=cjs --outfile=.check/map-search.cjs --log-level=error && node .check/map-search.cjs",
    "check:seatbelt": "esbuild scripts/seatbelt-check.ts --bundle --platform=node --format=cjs --outfile=.check/seatbelt.cjs --log-level=error --loader:.png=empty --define:import.meta.env={} && node .check/seatbelt.cjs",
