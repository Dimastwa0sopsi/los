    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "check:server": "esbuild scripts/server-check.ts --bundle --platform=node --format=cjs --outfile=.check/server.cjs --log-level=error && node .check/server.cjs",
    "check:version": "esbuild scripts/version-check.ts --bundle --platform=node --format=cjs --outfile=.check/version.cjs --log-level=error && node .check/version.cjs",
