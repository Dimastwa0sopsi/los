    "@types/react-test-renderer": "^19.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "5.1.1",
    "react-test-renderer": "^19.2.6",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
