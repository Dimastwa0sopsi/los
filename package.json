    "check:economy-barrier": "esbuild scripts/economy-barrier-check.ts --bundle --platform=node --format=cjs --outfile=.check/economy-barrier.cjs --log-level=error && node .check/economy-barrier.cjs",
    "check:economy-game-lab": "esbuild scripts/economy-game-lab-check.ts --bundle --platform=node --format=cjs --outfile=.check/economy-game.cjs --log-level=error --loader:.png=empty --define:import.meta.env={} && node .check/economy-game.cjs",
    "check:economy-journal": "esbuild scripts/economy-journal-check.ts --bundle --platform=node --format=cjs --outfile=.check/economy-journal.cjs --log-level=error && node .check/economy-journal.cjs"
