{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:world": "esbuild scripts/world-check.ts --bundle --platform=node --format=cjs --outfile=.check/world.cjs --log-level=error && node .check/world.cjs",
    "check:terrain": "esbuild scripts/terrain-probe.ts --bundle --platform=node --format=cjs --outfile=.check/terrain.cjs --log-level=error && node .check/terrain.cjs",
    "check:keys": "esbuild scripts/keys-check.ts --bundle --platform=node --format=cjs --outfile=.check/keys.cjs --log-level=warning && node .check/keys.cjs",
    "check:farm": "esbuild scripts/farm-check.ts --bundle --platform=node --format=cjs --outfile=.check/farm.cjs --log-level=error && node .check/farm.cjs",
    "check:npc": "esbuild scripts/npc-check.ts --bundle --platform=node --format=cjs --outfile=.check/npc.cjs --log-level=error && node .check/npc.cjs",
    "check:rides": "esbuild scripts/rides-check.ts --bundle --platform=node --format=cjs --outfile=.check/rides.cjs --log-level=error && node .check/rides.cjs",
    "check:police": "esbuild scripts/police-check.ts --bundle --platform=node --format=cjs --outfile=.check/police.cjs --log-level=error && node .check/police.cjs",
    "check:interiors": "esbuild scripts/interiors-check.ts --bundle --platform=node --format=cjs --outfile=.check/interiors.cjs --log-level=error && node .check/interiors.cjs",
    "bump": "npm version patch --no-git-tag-version && node -e \"const p=require('./package.json');console.log('Версия игры:',p.version,'— добавьте запись в CHANGELOG.md')\"",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "check:server": "esbuild scripts/server-check.ts --bundle --platform=node --format=cjs --outfile=.check/server.cjs --log-level=error && node .check/server.cjs",
    "check:version": "esbuild scripts/version-check.ts --bundle --platform=node --format=cjs --outfile=.check/version.cjs --log-level=error && node .check/version.cjs",
    "check:ads": "esbuild scripts/ads-check.ts --bundle --platform=node --format=cjs --outfile=.check/ads.cjs --log-level=error && node .check/ads.cjs",
    "check:mesh": "esbuild scripts/mesh-check.ts --bundle --platform=node --format=cjs --outfile=.check/mesh.cjs --log-level=error --loader:.png=empty && node .check/mesh.cjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
